# ---- DeepSeek (LLM) ----
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- OCR (Windows default shown; leave empty if tesseract is on PATH) ----
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---- Embeddings ----
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ---- Qdrant ----
# Leave QDRANT_URL empty = embedded local database in data/qdrant_db (no server needed).
# For Docker / Qdrant Cloud:  QDRANT_URL=http://localhost:6333   (and QDRANT_API_KEY=... for cloud)
QDRANT_URL=
QDRANT_API_KEY=

# ---- Optional tuning ----
# CHUNK_CHARS=1000
# CHUNK_OVERLAP_CHARS=150
# TOP_K=5
# NEAR_DUPLICATE_THRESHOLD=0.97
