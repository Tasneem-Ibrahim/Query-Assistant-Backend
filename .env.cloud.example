# Backend secrets only; never commit real values or put them in the frontend.
STORAGE_BACKEND=supabase
SUPABASE_URL=https://https://swhahnfaxcsnccrehrvz.supabase.co
# Legacy service_role JWT, NOT the anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=knowledge-pdfs
QDRANT_URL=
QDRANT_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Full OpenAI-compatible /embeddings endpoint accepting {model,input}.
EMBEDDING_PROVIDER=api
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=
# Model's actual default output dimension.
EMBEDDING_DIMENSIONS=0

# Mistral-compatible OCR; needed for scanned pages and pages with images.
OCR_API_URL=https://api.mistral.ai/v1/ocr
OCR_API_KEY=
OCR_API_MODEL=mistral-ocr-latest
CORS_ORIGINS=https://YOUR_FRONTEND.vercel.app,http://localhost:3000
