# Local configuration and secrets; keep shareable examples.
.env
.env.*
!.env.example
!.env.*.example

# Python environments and generated bytecode.
.venv/
venv/
env/
__pycache__/
*.py[cod]

# Test, type-checker, and packaging output.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/
*.egg-info/

# Runtime data: Qdrant, extraction caches, and knowledge-base registries.
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3

# Ignore uploaded documents, but retain the two bundled sample PDFs.
pdfs/**
!pdfs/customer_support/
!pdfs/legal_assistant/
!pdfs/customer_support/NovaMart_Customer_Support_Handbook.pdf
!pdfs/legal_assistant/Master_Services_Agreement.pdf

# Logs, archives, and local hosting files.
*.log
*.zip
*.7z
*.rar
.vercel/

# OS and editor files.
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
